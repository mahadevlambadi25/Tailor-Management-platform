# ============================================================================
# TAILOR MANAGEMENT SYSTEM V1 – ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================

# ----------------------------------------------------------------------------
# BACKEND CONFIGURATION (Render Web Service: tailor-management-backend)
# ----------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Configuration for Render (IPv4 Accessible Connection Pooling)
#
# IMPORTANT CONFIGURATION RULES:
# 1. Do NOT put quotes around the values when adding them to the Render dashboard.
# 2. If your database password contains special characters (@, #, $, !, %, &, +, /, :, ?),
#    they MUST be URL-encoded (e.g. '@' becomes '%40', '#' becomes '%23').
# 3. Use postgresql:// scheme (do not use postgres://).
#
# DATABASE_URL: Supabase Transaction Mode Pooler (Port 6543 with ?pgbouncer=true)
# Used by Prisma Client for application queries over IPv4.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true

# DIRECT_URL: Supabase Session Mode Pooler (Port 5432)
# Used by Prisma Migrate (prisma migrate deploy) over IPv4 for schema migrations.
DIRECT_URL=postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Authentication & JWT Secrets (Generate secure random 32+ character strings)
JWT_SECRET=generate_a_secure_random_string_for_jwt_secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=generate_a_secure_random_string_for_jwt_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Allowed Frontend Origins (Render Static Site URL or custom domain)
CORS_ORIGIN=https://tailor-management-frontend.onrender.com

# Multi-Tenancy & Security Settings
DEFAULT_TENANT_SLUG=royal-bespoke
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# ----------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Render Static Site: tailor-management-frontend)
# ----------------------------------------------------------------------------
# The public API URL of the deployed backend Render Web Service
VITE_API_URL=https://tailor-management-backend.onrender.com
VITE_CONVERSION_V1=false
VITE_WHATSAPP_NUMBER=919999999999
