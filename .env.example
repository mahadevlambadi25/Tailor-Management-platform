# ===================================================
# TAILOR MANAGEMENT SYSTEM V1 – ENVIRONMENT CONFIGURATION
# ===================================================

# -----------------
# BACKEND CONFIG (Render Web Service)
# -----------------
PORT=5000
NODE_ENV=production

# Database Connection (PostgreSQL on Render)
# - Render Internal URL (Best for Render Web Service): postgres://tailor_admin:PASSWORD@dpg-xxxxxx-a:5432/tailor_db
# - Render External URL (For local tools/external): postgres://tailor_admin:PASSWORD@dpg-xxxxxx-a.oregon-postgres.render.com/tailor_db?sslmode=require
DATABASE_URL="postgres://tailor_admin:YOUR_PASSWORD@dpg-xxxxxx-a:5432/tailor_db"

# Authentication & Security
JWT_SECRET="generate_a_strong_random_secret_string"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="generate_a_strong_random_refresh_secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Multi-Tenancy & Allowed CORS Origins (comma-separated if multiple)
DEFAULT_TENANT_SLUG="royal-bespoke"
CORS_ORIGIN="https://tailor-frontend.onrender.com"

# Storage Settings
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./uploads"
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# -----------------
# FRONTEND CONFIG (Render Static Site)
# -----------------
# Deployed Render backend URL
VITE_API_URL="https://tailor-backend.onrender.com"
