# Dependencies
node_modules/
.pnp
.pnp.js

# Environment Variables
.env
.env.*
!.env.example
!*.env.example

# Production Builds
dist/
build/
*.tsbuildinfo

# Uploads & Storage (keep directory structure if needed)
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Tests / Coverage
coverage/
.nyc_output/

# Local Scratch / Disposable Verification Scripts
backend/scripts/run-disposable-verification.js

# Terraform / OpenTofu
# State and plan files can contain plaintext secrets (RDS password, Secrets Manager values)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan

# Variable files (real values); terraform.tfvars.example stays tracked
*.tfvars
*.tfvars.json

# Crash logs (also covered by *.log above; kept explicit in case that rule changes)
crash.log
crash.*.log

# Local overrides and CLI config
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# NOTE: do NOT ignore .terraform.lock.hcl; it pins provider checksums and must be committed
