# ==============================================================================
# OpenTofu Variable Configuration Example (Production - ap-south-1)
# ==============================================================================

aws_region  = "ap-south-1"
environment = "production"
project_name = "tailor-management"

# Networking
vpc_cidr                 = "10.0.0.0/16"
availability_zones       = ["ap-south-1a", "ap-south-1b"]
public_subnet_cidrs      = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs     = ["10.0.10.0/24", "10.0.20.0/24"]
enable_nat_gateway_per_az = false # Set true for high redundancy; false for single NAT to save cost

# Fargate Compute Sizing
fargate_cpu    = 512   # 0.5 vCPU
fargate_memory = 1024  # 1024 MB RAM
desired_count  = 2     # 2 Web tasks running across AZs
min_capacity   = 1
max_capacity   = 4

# HTTPS Configuration (Optional: provide ACM ARN once issued)
# acm_certificate_arn = "arn:aws:acm:ap-south-1:123456789012:certificate/your-cert-uuid"

# Frontend CORS Configuration
cors_allowed_origins = "https://app.tailorsystem.com,https://tailorsystem.com"

# RDS PostgreSQL Configuration (Cost-conscious defaults)
database_subnet_cidrs      = ["10.0.30.0/24", "10.0.40.0/24"]
db_name                    = "tailor_management"
db_username                = "tailor_admin"
db_instance_class          = "db.t4g.micro" # Graviton2 (~$11.70/mo in ap-south-1)
db_allocated_storage       = 20             # gp3 SSD
db_max_allocated_storage   = 100            # Storage autoscaling ceiling
db_multi_az                = false          # Set true for HA production
db_deletion_protection     = true           # Safety guard against accidental teardown
db_backup_retention_period = 7              # Retain 7 days of automated snapshots

# Frontend S3 + CloudFront Hosting
cloudfront_price_class      = "PriceClass_200" # Includes India (ap-south-1) edge locations
enable_cloudfront_api_proxy = true             # Proxies /api/* to ALB to eliminate CORS
# frontend_custom_domain      = "app.tailorsystem.com"
# cloudfront_acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/your-cf-cert-uuid"

# CI/CD Deployment (GitHub Actions OIDC)
# github_repository = "your-github-username/tailor-management"
