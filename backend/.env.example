# ============================================================================
# TAILOR MANAGEMENT SYSTEM V1 – BACKEND ENVIRONMENT CONFIGURATION
# ============================================================================

# Port provided automatically by Render (defaults to 10000 or 5000)
PORT=5000
NODE_ENV=production

# Database Connection (PostgreSQL hosted on Supabase / Render)
#
# IMPORTANT FOR SUPABASE ON RENDER (IPv4 compatibility & connection pooling):
# - Direct Supabase endpoints (db.[ref].supabase.co) resolve to IPv6 only on free/standard tiers.
# - Render outbound connections operate on IPv4. Direct connection will fail with Prisma P1001.
# - Use Supabase Supavisor Connection Pooler (aws-0-[region].pooler.supabase.com) which has IPv4 routing.
#
# 1. DATABASE_URL: Supabase Transaction Mode Pooler (Port 6543 with ?pgbouncer=true) for runtime queries
#    postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
#
# 2. DIRECT_URL: Supabase Session Mode Pooler (Port 5432) for Prisma migrations (prisma migrate deploy)
#    postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# NOTE: In Render Dashboard, enter values WITHOUT quotes. If password has special characters, URL-encode them.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# JWT Authentication Secrets (Generate secure random 32+ char strings)
JWT_SECRET="generate_a_secure_random_string_for_jwt_secret"
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET="generate_a_secure_random_string_for_jwt_refresh_secret"
JWT_REFRESH_EXPIRES_IN=7d

# Allowed Frontend Origins (Comma-separated if multiple, e.g., Render Static Site URL)
CORS_ORIGIN="https://tailor-management-frontend.onrender.com"

# Local Storage Provider
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# Multi-Tenancy & Security Settings
DEFAULT_TENANT_SLUG=royal-bespoke
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Razorpay SaaS Subscription Credentials (Test/Live)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Conversion V1 Feature Set (Default: false in prod, true in dev)
CONVERSION_V1=false
WHATSAPP_NUMBER=919999999999
DEMO_VIDEO_URL_EN=
DEMO_VIDEO_URL_HI=
DEMO_VIDEO_URL_KN=
