# Port provided automatically by Render (defaults to 10000 or 5000)
PORT=5000
NODE_ENV=production

# Database Connection (PostgreSQL on Render)
# - Render Internal URL (Best for Render Web Service): postgres://tailor_admin:PASSWORD@dpg-xxxxxx-a:5432/tailor_db
# - Render External URL (For local tools/external): postgres://tailor_admin:PASSWORD@dpg-xxxxxx-a.oregon-postgres.render.com/tailor_db?sslmode=require
DATABASE_URL="postgres://tailor_admin:YOUR_PASSWORD@dpg-xxxxxx-a:5432/tailor_db"

# JWT Authentication Secrets (Generate secure random 32+ char strings)
JWT_SECRET="generate_a_secure_random_string_for_jwt_secret"
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET="generate_a_secure_random_string_for_jwt_refresh_secret"
JWT_REFRESH_EXPIRES_IN=7d

# Allowed Frontend Origins (Comma-separated if multiple, e.g., Render Static Site URL)
CORS_ORIGIN="https://tailor-management-frontend.onrender.com"

# Local Storage Provider
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# Multi-Tenancy & Security Settings
DEFAULT_TENANT_SLUG=royal-bespoke
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
